# garmin_mcp environment configuration
# Copy to `.env` and fill in real values. `.env` is gitignored.

# 32-byte random token (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
# Claude.ai must send `Authorization: Bearer <this>` on every request.
CONNECTOR_BEARER_TOKEN=

# Strava OAuth app credentials (https://www.strava.com/settings/api).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Populated by `scripts/strava_bootstrap.py` after the one-time OAuth dance.
STRAVA_REFRESH_TOKEN=

# Directory holding Garmin SSO tokens (written by `scripts/garmin_bootstrap.py`).
GARMIN_TOKEN_DIR=~/.garminconnect

# JSONL audit log for every Garmin write call.
AUDIT_LOG_PATH=~/.fitness-mcp/logs/writes.jsonl

# IANA timezone for date interpretation. Locked to Tunis for the current plan.
USER_TIMEZONE=Africa/Tunis
